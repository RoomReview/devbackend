{
  "name": "roomreview-backend",
  "version": "0.1.0",
  "description": "RoomReview Backend API - Express.js with TypeScript",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm run audit:security",
    "build": "prisma generate && tsdown",
    "build:dev": "prisma generate && tsdown",
    "build:prod": "prisma generate && tsdown",
    "start": "node dist/index.mjs",
    "start:cjs": "node dist/index.cjs",
    "sync:bigquery": "tsx scripts/sync-bigquery.ts",
    "typecheck": "tsc",
    "performance:api": "node scripts/api-performance-smoke.mjs",
    "lint": "eslint src/** --concurrency auto --cache",
    "lint:fix": "eslint src/** --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "node scripts/run-tests.mjs --experimental-test-coverage **/*test.ts",
    "test:integration": "node scripts/run-tests.mjs --experimental-test-coverage src/services/payment.integration.test.ts src/services/score-report.integration.test.ts",
    "test:watch": "tsx --experimental-test-coverage --watch --test **/*test.ts",
    "prisma:generate": "node scripts/migrate.mjs generate",
    "prisma:init": "node scripts/migrate.mjs init",
    "prisma:rollforward": "node scripts/migrate.mjs rollforward",
    "prisma:rollback": "node scripts/migrate.mjs rollback",
    "prisma:seed": "tsx scripts/seed.ts",
    "seed": "npm run prisma:seed",
    "docs:generate": "tsx scripts/generate-swagger.ts",
    "audit:security": "npm audit --audit-level=moderate",
    "prebuild:dev": "npm run audit:security",
    "prebuild:prod": "npm run audit:security"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1143.0",
    "@aws-sdk/s3-request-presigner": "3.1143.0",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@google-cloud/bigquery": "9.0.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sendgrid/mail": "8.1.6",
    "cors": "2.8.6",
    "disposable-email-domains": "1.0.62",
    "dotenv": "17.3.1",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.3",
    "morgan": "1.12.1",
    "passport": "0.7.0",
    "passport-facebook": "3.0.0",
    "passport-google-oauth20": "2.0.0",
    "pg": "8.20.0",
    "playwright-core": "1.58.2",
    "swagger-jsdoc": "6.3.0",
    "uuid": "13.0.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tsconfig/node20": "20.1.9",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/node": "20.19.35",
    "@types/passport": "1.0.17",
    "@types/passport-facebook": "3.0.4",
    "@types/passport-google-oauth20": "2.0.17",
    "@types/pg": "8.18.0",
    "@types/supertest": "7.2.0",
    "@types/swagger-jsdoc": "6.0.4",
    "eslint": "10.0.2",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.4.0",
    "jiti": "2.6.1",
    "prettier": "3.8.1",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "tsdown": "0.21.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "esbuild": "0.28.2",
    "mysql2": "3.24.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
