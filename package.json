{
  "name": "roomreview-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run audit:security",
    "build": "vite build",
    "postbuild": "node scripts/generate-sitemap.mjs",
    "audit:security": "npm audit --audit-level=moderate",
    "preview": "vite preview",
    "performance:smoke": "node scripts/performance-smoke.mjs",
    "performance:api": "node ../devbackend/scripts/api-performance-smoke.mjs",
    "audit:images": "node scripts/asset-audit.mjs",
    "audit:bundle": "node scripts/bundle-budget.mjs",
    "data:transport": "node scripts/generate-transport-geojson.mjs",
    "data:transport:validate": "node scripts/generate-transport-geojson.mjs --check",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@tanstack/react-query": "5.95.2",
    "axios": "1.20.0",
    "html2pdf.js": "0.14.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.7.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router": "7.18.4",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.2.2",
    "@types/leaflet": "1.9.22",
    "@types/node": "25.5.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.0.2",
    "globals": "17.4.0",
    "playwright": "1.58.2",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "4.1.12",
    "vitest-browser-react": "2.2.0"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
