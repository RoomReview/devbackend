{
  "name": "roomreview-backend",
  "version": "0.1.0",
  "description": "RoomReview Backend API - Express.js with TypeScript",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsdown",
    "build:dev": "tsc && tsdown",
    "build:prod": "tsc && tsdown",
    "start": "node dist/index.mjs",
    "start:cjs": "node dist/index.cjs",
    "sync:bigquery": "tsx scripts/sync-bigquery.ts",
    "typecheck": "tsc",
    "lint": "eslint src/** --concurrency auto --cache",
    "lint:fix": "eslint src/** --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "tsx --experimental-test-coverage --test **/*test.ts",
    "test:watch": "tsx --experimental-test-coverage --watch --test **/*test.ts",
    "prisma:generate": "node scripts/migrate.mjs generate",
    "prisma:init": "node scripts/migrate.mjs init",
    "prisma:rollforward": "node scripts/migrate.mjs rollforward",
    "prisma:rollback": "node scripts/migrate.mjs rollback",
    "prisma:seed": "tsx scripts/seed.ts",
    "seed": "npm run prisma:seed",
    "docs:generate": "tsx scripts/generate-swagger.ts"
  },
  "dependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@google-cloud/bigquery": "^9.0.3",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@sendgrid/mail": "^8.1.6",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.19.0",
    "swagger-jsdoc": "^6.2.8",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node20": "^20.1.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.0",
    "@types/passport": "^1.0.17",
    "@types/passport-facebook": "^3.0.4",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "jiti": "^2.6.1",
    "prettier": "^3.8.1",
    "prisma": "^7.4.2",
    "supertest": "^7.2.2",
    "tsdown": "^0.21.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.56.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
