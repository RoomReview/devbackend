PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://user:password@localhost:5432/roomreview?schema=public"
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
SENDGRID_API_KEY=ypur-sendgrid-api-key
EMAIL_FROM=valid-email-address
SENDGRID_SANDBOX_MODE=true
ROOMREVIEW_CONTACT_LINK=http://localhost:3000/contact-us
ROOMREVIEW_RESET_PASSWORD_LINK=http://localhost:3000/reset-password

# SSO — Google OAuth 2.0
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/sso/google/callback

# SSO — Facebook Login
# Create app at: https://developers.facebook.com/apps
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/v1/sso/facebook/callback

# Frontend URL — where to redirect after OAuth success/failure
FRONTEND_URL=http://localhost:3000