{
  "folders": [
    {
      "path": "."
    }
  ],

  // ─── Editor & Formatter ───────────────────────────────────────────────────
  "settings": {
    // Use project-local TypeScript version (avoids version drift)
    "typescript.tsdk": "node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,

    // Prettier as the default formatter for TS/JS
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    },

    // ESLint scope
    "eslint.workingDirectories": [{ "mode": "auto" }],
    "eslint.validate": ["typescript", "javascript"],

    // File nesting — keep explorer tidy
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
      "*.ts": "${capture}.test.ts, ${capture}.spec.ts",
      "prisma": "*.prisma",
      "package.json": "package-lock.json, .npmrc, .nvmrc, .node-version",
      "tsconfig.json": "tsconfig.*.json",
      ".env.example": ".env, .env.*"
    },

    // Hide noisy folders from the explorer
    "files.exclude": {
      "node_modules": true,
      "dist": true,
      ".git": false
    },

    // Search exclusions (speeds up Ctrl+Shift+F significantly)
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "src/generated": true
    }
  },

  // ─── Extension Recommendations ───────────────────────────────────────────
  "extensions": {
    "recommendations": [
      "esbenp.prettier-vscode",          // Prettier formatter
      "dbaeumer.vscode-eslint",          // ESLint integration
      "prisma.prisma",                   // Prisma schema syntax + format
      "eamodio.gitlens",                 // Git blame, history
      "humao.rest-client",               // Test HTTP endpoints via .http files
      "streetsidesoftware.code-spell-checker", // Catch typos in comments/strings
      "ms-vscode.vscode-typescript-next" // Latest TS language features
    ],
    "unwantedRecommendations": [
      "ms-vscode.vscode-jest"            // Project uses node:test, not Jest
    ]
  },

  // ─── Tasks (npm scripts surfaced as VS Code tasks) ────────────────────────
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "dev: start server",
        "type": "shell",
        "command": "npm run dev",
        "group": { "kind": "build", "isDefault": true },
        "problemMatcher": ["$tsc"],
        "isBackground": true,
        "presentation": { "panel": "dedicated", "reveal": "always" }
      },
      {
        "label": "test: run all",
        "type": "shell",
        "command": "npm test",
        "group": { "kind": "test", "isDefault": true },
        "problemMatcher": [],
        "presentation": { "panel": "dedicated", "reveal": "always" }
      },
      {
        "label": "lint: check",
        "type": "shell",
        "command": "npm run lint",
        "problemMatcher": ["$eslint-stylish"],
        "presentation": { "panel": "shared", "reveal": "silent" }
      },
      {
        "label": "prisma: studio",
        "type": "shell",
        "command": "npx prisma studio",
        "problemMatcher": [],
        "isBackground": true,
        "presentation": { "panel": "dedicated", "reveal": "always" }
      }
    ]
  },

  // ─── Debugger ─────────────────────────────────────────────────────────────
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug: dev server",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "node",
        "runtimeArgs": [
          "--import", "tsx/esm",   // ESM + TypeScript support — no compile step
          "--inspect"
        ],
        "args": ["src/index.ts"],
        "env": { "NODE_ENV": "development" },
        "envFile": "${workspaceFolder}/.env",
        "cwd": "${workspaceFolder}",
        "sourceMaps": true,
        "resolveSourceMapLocations": ["${workspaceFolder}/src/**"],
        "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
      },
      {
        "name": "Debug: current test file",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "node",
        "runtimeArgs": ["--import", "tsx/esm", "--test"],
        "args": ["${file}"],
        "envFile": "${workspaceFolder}/.env",
        "cwd": "${workspaceFolder}",
        "sourceMaps": true,
        "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
      }
    ]
  }
}